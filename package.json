{
  "name": "mediaflow-studio",
  "version": "26.10.26",
  "description": "DataFlow Studio — Professional Media Ingestion, Synchronization and Report Fusion Desktop Suite",
  "main": "dist-electron/main.js",
  "author": "BSFrameWorks",
  "copyright": "Copyright © 2026 BSFrameWorks",
  "license": "Commercial",
  "scripts": {
    "dev": "concurrently -k -r \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on -t 30000 tcp:127.0.0.1:5173 && npm run build:electron && cross-env NODE_ENV=development electron dist-electron/main.js",
    "build:vite": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron/engines/scripts', {recursive:true}); fs.copyFileSync('electron/engines/scripts/excel_merger.py', 'dist-electron/engines/scripts/excel_merger.py'); fs.copyFileSync('electron/engines/scripts/generate_separation_report.py', 'dist-electron/engines/scripts/generate_separation_report.py')\"",
    "build:installer-assets": "python scripts/generate_installer_assets.py && python scripts/generate_appx_assets.py",
    "build": "npm run build:installer-assets && npm run build:vite && npm run build:electron",
    "build:win": "npm run build && electron-builder --win portable nsis zip --x64",
    "release": "node scripts/package-release.mjs",
    "release:package": "node scripts/package-release.mjs",
    "release:github": "node scripts/publish-to-github.mjs",
    "package:exe": "npm run build && electron-builder --win nsis",
    "package:msi": "npm run build && electron-builder --win msi",
    "package:msix": "npm run build && electron-builder --win appx",
    "package:all": "npm run build && electron-builder --win portable nsis zip --x64",
    "package:portable": "npm run build && electron-builder --win portable",
    "package:publish": "node scripts/package-release.mjs",
    "analyze:context": "python scripts/codebase_analyzer.py",
    "builder:gui": "python scripts/release_builder_gui.py",
    "start": "npx electron dist-electron/main.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "dist": "npm run package:exe"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.burhanuddin.mediaflowstudio",
    "productName": "MediaFlow Studio",
    "copyright": "Copyright © 2026 BSFrameWorks",
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    },
    "publish": {
      "provider": "github",
      "owner": "BSFrameWorks5253",
      "repo": "MediaFlow-Studio"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "asarUnpack": [
      "dist-electron/engines/scripts/**/*"
    ],
    "extraResources": [
      {
        "from": "electron/engines/scripts/excel_merger.py",
        "to": "scripts/excel_merger.py"
      },
      {
        "from": "electron/engines/scripts/generate_separation_report.py",
        "to": "scripts/generate_separation_report.py"
      },
      {
        "from": "public/assets/app.ico",
        "to": "assets/app.ico"
      },
      {
        "from": "public/assets/icon.png",
        "to": "assets/icon.png"
      }
    ],
    "win": {
      "icon": "public/assets/app.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Mediaflow_studio_${version}.${ext}",
      "legalTrademarks": "BSFrameWorks MediaFlow",
      "publisherName": "BSFrameWorks"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MediaFlow Studio",
      "uninstallDisplayName": "MediaFlow Studio v6.0",
      "runAfterFinish": true,
      "installerIcon": "public/assets/app.ico",
      "uninstallerIcon": "public/assets/app.ico",
      "installerHeader": "build/installerHeader.bmp",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "artifactName": "Mediaflow_studio_${version}_Setup.exe"
    },
    "portable": {
      "artifactName": "Mediaflow_studio_${version}.exe"
    },
    "msi": {
      "oneClick": false,
      "shortcutName": "MediaFlow Studio",
      "artifactName": "${productName} v${version}.${ext}"
    },
    "appx": {
      "identityName": "BS.Framework.MediaFlowStudio",
      "publisherDisplayName": "BS.Framework",
      "publisher": "CN=B2B152C3-5239-413B-BE54-035A4A6AFF1E",
      "applicationId": "MediaFlowStudio",
      "displayName": "MediaFlow Studio",
      "languages": [
        "en-US"
      ],
      "backgroundColor": "#07080d",
      "showNameOnTiles": true,
      "artifactName": "${productName}_Store_v${version}.${ext}"
    }
  }
}